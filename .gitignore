# SPDX-License-Identifier: MPL-2.0
# RSR-compliant .gitignore

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Build
/target/
/_build/
/build/
/dist/
/out/

# Dependencies
/node_modules/
# /vendor/ is ignored except the reviewed Bunsenite vendor fork used by the
# `nickel` feature (see vendor/bunsenite/VENDOR.adoc)
/vendor/*
!/vendor/bunsenite/
/deps/
/.elixir_ls/

# Rust
# Cargo.lock  # Keep for binaries

# Elixir
/cover/
/doc/
*.ez
erl_crash.dump
# Built OTP arbiter escript artifact (rebuilt by `mix escript.build`)
/src/arbiter/conative_arbiter

# Julia
*.jl.cov
*.jl.mem
/Manifest.toml

# ReScript
/lib/bs/
/.bsb.lock

# Python (SaltStack only)
__pycache__/
*.py[cod]
.venv/

# Ada/SPARK
*.ali
/obj/
/bin/

# Haskell
/.stack-work/
/dist-newstyle/

# Chapel
*.chpl.tmp.*

# Secrets
.env
.env.*
*.pem
*.key
secrets/

# Test/Coverage
/coverage/
htmlcov/

# Logs
*.log
/logs/

# Temp
/tmp/
*.tmp
*.bak

# Generated test baselines
.conative/

# Crash recovery artifacts
ai-cli-crash-capture/
SONNET-TASKS.md
target/
node_modules/
_build/
deps/
.elixir_ls/
.cache/
build/
dist/
